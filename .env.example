# Copy to .env (never commit .env) or set these in the hosting dashboard.

# PostgreSQL connection string. Leave empty to use the local SQLite file in data/.
DATABASE_URL=

# Local SQLite file when DATABASE_URL is empty (default: data/meo.db).
# DATABASE_FILE=./data/meo.db

# Required in production (NODE_ENV=production) and must be at least 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local development
NODE_ENV=development
PORT=3000

# Session lifetime in days (default 30). Short sessions last 7 days.
SESSION_DAYS=30

# Set to 1 when running behind Render/Railway/a reverse proxy so rate limits
# and cookies use the real client IP and HTTPS scheme.
TRUST_PROXY=0

# Comma-separated extra origins allowed for CSRF checks (usually unnecessary).
CORS_ORIGIN=

# Force SSL for PostgreSQL (also enabled automatically by sslmode=require).
PGSSL=false
