# Copy to .env (never commit .env) or set these in the hosting dashboard.

# PostgreSQL connection string. Leave empty to use the local SQLite file in data/.
DATABASE_URL=

# Local SQLite file when DATABASE_URL is empty (default: data/meo.db).
# DATABASE_FILE=./data/meo.db

# Required in production (NODE_ENV=production) and must be at least 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local development
NODE_ENV=development
PORT=3000

# Session lifetime in days (default 30). Short sessions last 7 days.
SESSION_DAYS=30

# Set to 1 when running behind Render/Railway/a reverse proxy so rate limits
# and cookies use the real client IP and HTTPS scheme.
TRUST_PROXY=0

# Comma-separated extra origins allowed for CSRF checks (usually unnecessary).
CORS_ORIGIN=

# Force SSL for PostgreSQL (also enabled automatically by sslmode=require).
PGSSL=false

# ---------------------------------------------------------------------------
# Email (xac thuc email + quen mat khau)
# ---------------------------------------------------------------------------
# URL cong khai cua app. Link trong thu luon duoc tao tu bien nay, KHONG dung
# Host/Origin cua request. Production bat buoc https (vi du
# https://meo-meo-caro.onrender.com). Local: http://localhost:3000.
PUBLIC_URL=http://localhost:3000

# console | smtp | resend | test
# - console: in thu ra terminal (chi nen dung khi phat trien)
# - smtp:    Gmail/Brevo/... qua SMTP_* ben duoi
# - resend:  gui qua API https://api.resend.com
# - test:    chi trong test, thu vao outbox noi bo; production tu tat
MAIL_PROVIDER=console

# Dia chi gui, vi du "Meo Meo Caro <no-reply@ten-mien-cua-ban.com>".
# Voi Gmail/SMTP phai trung tai khoan SMTP; voi Resend phai thuoc domain da xac minh.
MAIL_FROM=

# SMTP (MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend (MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Thoi han token (phut cho dat lai, gio cho xac thuc email).
RESET_TOKEN_MINUTES=30
VERIFY_TOKEN_HOURS=24
